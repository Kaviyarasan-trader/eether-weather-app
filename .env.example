# Copy to .env and replace values for your environment.
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-value
WEATHER_API_KEY=replace-with-your-openweathermap-key
WEATHER_API_BASE=https://api.openweathermap.org
WEATHER_TILE_BASE=https://tile.openweathermap.org
WEATHER_ONECALL_KEY=

# OpenRouter-powered Weather Assistant (backend only; never expose the key)
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
